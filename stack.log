=== INICIO DE paging.cpp ===
// paging.cpp
#include "paging.h"
#include "screen.h"
#include "heap.h"          // kmalloc para paging_map_shared_in_current

// =====================================================================
// Estado interno
// =====================================================================
// El directorio se expone como variable global (no static) para que
// otros modulos del kernel (p.ej. debug) puedan consultarlo. El simbolo
// tiene nombre estable y esta alineado a 4 KiB.
unsigned int page_directory[1024] __attribute__((aligned(4096)));
static unsigned int page_table_0[1024] __attribute__((aligned(4096)));

// Pool de PTs preasignadas para el kernel (identity map 0..128 MB).
// Solo lo usa paging_map cuando la PDE esta vacia y el llamante es
// paging_map_range de kernel. Las PTs del espacio de usuario se piden
// a kmalloc (ver paging_map_shared_in_current), asi no agotamos el pool
// del kernel.
#define PT_POOL_SIZE 32
static unsigned int pt_pool[PT_POOL_SIZE][1024] __attribute__((aligned(4096)));
static int pt_pool_next = 0;

extern "C" void paging_enable_asm(unsigned int pd_phys);

// =====================================================================
// INIT
// =====================================================================
extern "C" void paging_init(void) {
    for (int i = 0; i < 1024; i++) {
        page_directory[i] = 0;
        page_table_0[i]   = 0;
    }
    pt_pool_next = 0;

    // Mapear los primeros 128 MB de RAM linealmente (identidad).
    // 128 MB = 32 page tables de 4 MB cada una.
    // Cubre kernel + heap + backbuffer.
    //
    // IMPORTANTE: se mapea con PTE_PRESENT | PTE_RW, sin PTE_USER.
    // El user code NO puede acceder a esta zona directamente.
    // El acceso controlado de ring3 al backbuffer se hace en
    // paging_map_shared_in_current(), que crea PTEs con PTE_USER
    // apuntando a la misma PA, en un rango de VA de usuario distinto.
    int PTs_needed = 32;
    if (PTs_needed > PT_POOL_SIZE) PTs_needed = PT_POOL_SIZE;

    for (int pt_i = 0; pt_i < PTs_needed; pt_i++) {
        unsigned int *pt;
        if (pt_i == 0) {
            pt = page_table_0;
        } else {
            pt = pt_pool[pt_i];
        }

        unsigned int base_phys = (unsigned int)pt_i * 0x400000u;

        for (int i = 0; i < 1024; i++) {
            pt[i] = (base_phys + (unsigned int)i * 0x1000u)
                    | PTE_PRESENT | PTE_RW;
        }

        page_directory[pt_i] = ((unsigned int)pt) | PTE_PRESENT | PTE_RW;
    }

    kprintf("paging: %d MB mapeados (0x0 - 0x%x)\n",
            PTs_needed * 4, PTs_needed * 0x400000u);
}

extern "C" void paging_enable_now(void) {
    paging_enable_asm((unsigned int)page_directory);
}

// =====================================================================
// Helpers internos
// =====================================================================

// Busca una PTE libre consecutiva de `pages` paginas en la zona de
// usuario (PDEs 0..767). Devuelve la VA base, o 0 si no encuentra.
// No crea PTs nuevas; para eso ver paging_map_shared_in_current.
static unsigned int find_free_user_va(unsigned int pages) {
    if (pages == 0 || pages > 1024) return 0;

    for (unsigned int pde = 0; pde < 768; pde++) {
        if (!(page_directory[pde] & PTE_PRESENT)) continue;

        unsigned int *pt = (unsigned int *)(page_directory[pde] & 0xFFFFF000u);

        unsigned int run = 0;
        for (unsigned int i = 0; i < 1024; i++) {
            if (!(pt[i] & PTE_PRESENT)) {
                run++;
                if (run == pages) {
                    return (pde << 22) | ((i - run + 1) << 12);
                }
            } else {
                run = 0;
            }
        }
    }
    return 0;
}

// Devuelve la PT de un PDE, creandola si no existe. La PT nueva se
// toma del pool del kernel o de kmalloc. Si `pde_is_user` es true,
// marca el PDE con PTE_USER y PTE_RW.
static unsigned int *ensure_page_table(unsigned int pde_index,
                                       int pde_is_user) {
    unsigned int e = page_directory[pde_index];
    if (e & PTE_PRESENT) {
        if (pde_is_user && !(e & PTE_USER)) {
            page_directory[pde_index] = e | PTE_USER | PTE_RW;
            asm volatile("invlpg (%0)" :: "r"(pde_index << 22) : "memory");
        }
        return (unsigned int *)(e & 0xFFFFF000u);
    }

    // Crear PT nueva
    unsigned int *new_pt = 0;

    if (!pde_is_user) {
        // Kernel: del pool preasignado.
        if (pt_pool_next >= PT_POOL_SIZE) return 0;
        new_pt = pt_pool[pt_pool_next++];
    } else {
        // Usuario: de kmalloc, para no agotar el pool del kernel.
        // El heap del kernel esta en identidad 0..128 MB, asi que la
        // PA == VA y el kernel puede escribirla directamente.
        void *p = kmalloc(4096);
        if (!p) return 0;
        new_pt = (unsigned int *)p;
    }

    for (int i = 0; i < 1024; i++) new_pt[i] = 0;

    unsigned int pde_flags = PTE_PRESENT | PTE_RW;
    if (pde_is_user) pde_flags |= PTE_USER;

    page_directory[pde_index] = ((unsigned int)new_pt) | pde_flags;
    return new_pt;
}

// =====================================================================
// paging_map  (comportamiento original, solo arreglos minimos)
// =====================================================================
extern "C" void paging_map(unsigned int virt, unsigned int phys,
                           unsigned int flags) {
    unsigned int pde_index = virt >> 22;
    unsigned int pt_index  = (virt >> 12) & 0x3FF;

    // Una PDE con PTE_USER solo se necesita si el llamante lo pide.
    int is_user = (flags & PTE_USER) ? 1 : 0;
    unsigned int *pt = ensure_page_table(pde_index, is_user);
    if (!pt) return;

    // Preservar cualquier otro bit de flags que el llamante haya puesto
    // (PTE_RW, PTE_USER, PTE_PWT, PTE_PCD, PTE_PAT, ...) y forzar PRESENT.
    pt[pt_index] = (phys & 0xFFFFF000u)
                 | (flags & 0xFFFu)
                 | PTE_PRESENT;

    asm volatile("invlpg (%0)" :: "r"(virt) : "memory");
}

// =====================================================================
// paging_map_range  (comportamiento original: 1 unidad = 4 KB)
// =====================================================================
extern "C" void paging_map_range(unsigned int virt, unsigned int phys,
                                 unsigned int size_kb, unsigned int flags) {
    // NOTA: por compatibilidad historica, "size_kb" es en realidad
    // numero de paginas (cada iteracion avanza 0x1000). Ver paging.h.
    for (unsigned int i = 0; i < size_kb; i++) {
        paging_map(virt + i * 0x1000u, phys + i * 0x1000u, flags);
    }
}

// =====================================================================
// paging_map_pages  (nueva API, inequivoca: pages * 4 KB)
// =====================================================================
extern "C" void paging_map_pages(unsigned int virt, unsigned int phys,
                                 unsigned int pages, unsigned int flags) {
    for (unsigned int i = 0; i < pages; i++) {
        paging_map(virt + i * 0x1000u, phys + i * 0x1000u, flags);
    }
}

// =====================================================================
// paging_unmap
// =====================================================================
extern "C" void paging_unmap(unsigned int virt) {
    unsigned int pde_index = virt >> 22;
    unsigned int pt_index  = (virt >> 12) & 0x3FF;

    if (!(page_directory[pde_index] & PTE_PRESENT)) return;

    unsigned int *pt = (unsigned int *)(page_directory[pde_index] & 0xFFFFF000u);
    pt[pt_index] = 0;

    asm volatile("invlpg (%0)" :: "r"(virt) : "memory");
}

// =====================================================================
// paging_map_shared_in_current
//
// Objetivo: dado un rango fisico `phys..phys+len` (que el kernel puede
// tocar via identidad 0..128 MB), devolver un VA accesible desde ring3
// que apunte a esa misma memoria fisica.
//
// Estrategia:
//   1) Si `phys` YA esta mapeada con PTE_USER en alguna PDE de usuario,
//      devolver esa VA (idempotencia).
//   2) En otro caso, buscar `pages` PTEs libres consecutivas en la zona
//      de usuario, crear la PT si hace falta, rellenar PTEs con
//      PTE_PRESENT|PTE_USER|pte_flags|PTE_RW, e invlpg.
//
// Zona de usuario: PDEs 0..767 (VA 0x00000000 .. 0xBFFFFFFF).
// Zona de kernel:  PDEs 768..1023, jamas se tocan aqui.
// =====================================================================
extern "C" unsigned int paging_map_shared_in_current(unsigned int phys,
                                                     unsigned int len,
                                                     unsigned int pte_flags) {
    if (len == 0) return 0;

    pte_flags |= PTE_PRESENT | PTE_USER | PTE_RW;

    unsigned int page_phys = phys & 0xFFFFF000u;
    unsigned int offset_in = phys & 0xFFFu;
    unsigned int page_len  = ((offset_in + len) + 0xFFFu) & 0xFFFFF000u;
    unsigned int pages     = page_len >> 12;

    // --- Paso 1: idempotencia ---
    // Buscar si page_phys ya esta mapeada con PTE_USER en una PDE de
    // usuario. Si es asi, devolver la VA correspondiente.
    for (unsigned int pde = 0; pde < 768; pde++) {
        if (!(page_directory[pde] & PTE_PRESENT)) continue;
        if (!(page_directory[pde] & PTE_USER))   continue;

        unsigned int *pt = (unsigned int *)(page_directory[pde] & 0xFFFFF000u);
        for (unsigned int i = 0; i < 1024; i++) {
            unsigned int e = pt[i];
            if (!(e & PTE_PRESENT)) continue;
            if (!(e & PTE_USER))    continue;
            if ((e & 0xFFFFF000u) == page_phys) {
                return (pde << 22) | (i << 12) | offset_in;
            }
        }
    }

    // --- Paso 2: buscar VA libre ---
    unsigned int va_base = find_free_user_va(pages);

    // Si no hay hueco contiguo en PTs existentes, crear una PT nueva
    // entera (1024 PTEs libres) en alguna PDE vacia de usuario.
    if (!va_base) {
        for (unsigned int pde = 0; pde < 768; pde++) {
            if (page_directory[pde] & PTE_PRESENT) continue;

            unsigned int *pt = ensure_page_table(pde, /*is_user=*/1);
            if (!pt) continue;

            va_base = pde << 22;
            break;
        }
    }

    if (!va_base) return 0;

    // --- Paso 3: rellenar PTEs ---
    for (unsigned int i = 0; i < pages; i++) {
        unsigned int va   = va_base + (i << 12);
        unsigned int p_pa = page_phys + (i << 12);
        unsigned int pde  = va >> 22;
        unsigned int pte  = (va >> 12) & 0x3FF;

        // Asegurar que la PDE existe (find_free_user_va ya garantiza
        // que existe para PTs encontradas; el camino de "PT nueva"
        // tambien la crea).
        unsigned int *pt = ensure_page_table(pde, /*is_user=*/1);
        if (!pt) return 0;

        pt[pte] = (p_pa & 0xFFFFF000u) | (pte_flags & 0xFFFu) | PTE_PRESENT;

        asm volatile("invlpg (%0)" :: "r"(va) : "memory");
    }

    return va_base + offset_in;
}

// =====================================================================
// Info interna
// =====================================================================
extern "C" unsigned int  paging_get_pd_addr(void)  { return (unsigned int)page_directory; }
extern "C" unsigned int  paging_get_pt0_addr(void) { return (unsigned int)page_table_0; }
extern "C" unsigned int *paging_get_directory(void){ return page_directory; }

