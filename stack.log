=== INICIO DE kernel.c ===
// kernel.c
#include "screen.h"
#include "idt.h"
#include "gdt.h"
#include "tss.h"
#include "pic.h"
#include "pit.h"
#include "keyboard.h"
#include "heap.h"
#include "paging.h"
#include "ahci.h"
#include "thread.h"
#include "syscall.h"
#include "user.h"
#include "vbe.h"
#include "gfx.h"
#include "win.h"
#include "pat.h"
#include "ramdisk.h"
#include "mouse.h"
#include "fat32.h"
#include "wallpaper.h"

void screen_set_gfx_mode(void);

static unsigned char ramdisk_buffer[64 * 1024] __attribute__((aligned(4096)));

extern "C" void kernel_main(void) {
    // --- init basico ------------------------------------------------
    idt_init();
    gdt_init();
    tss_init();
    pic_remap();
    pit_init(100);
    keyboard_init();

    paging_init();
    paging_enable_now();
    pat_init();
    heap_init();

    {
        int rd = ramdisk_create_static((unsigned int)ramdisk_buffer,
                                       (unsigned int)sizeof(ramdisk_buffer));
        if (rd >= 0)
            kprintf("Ramdisk: id=%d, %u bytes\n", rd,
                    (unsigned int)sizeof(ramdisk_buffer));
        else
            kprintf("Ramdisk: no se pudo crear\n");
    }

    // --- VBE + GFX + backbuffer ------------------------------------
    vbe_init();
    if (vbe_available()) {
        gfx_init();
        gfx_backbuffer_init();
        gfx_clear(0x00000000);
        gfx_backbuffer_flip();
        screen_set_gfx_mode();

        kprintf("MiniOS v10.0\n=================\n\n");
        kprintf("VBE: %ux%u %ubpp\n",
                vbe_width(), vbe_height(), vbe_bpp());
        kprintf("FB:  %x  pitch=%u bytes\n",
                vbe_fb_addr(), vbe_pitch());
        kprintf("\n");
    } else {
        kprintf("VBE no disponible, sigo en modo texto\n");
    }

    kprintf("IDT cargada\nGDT recargada\nTSS cargado\n"
            "PIC remapeado\nPIT a 100 Hz\nTeclado listo\n"
            "Paging activado\nHeap inicializado\n");

    // --- AHCI ------------------------------------------------------
    kprintf("Iniciando AHCI...\n");
    if (ahci_init()) {
        unsigned int sec = (unsigned int)ahci_get_sector_count();
        unsigned int mib = (unsigned int)((sec * 512ULL) / (1024ULL * 1024ULL));
        kprintf("AHCI: %u sectores (%u MiB), puerto %d\n",
                sec, mib, ahci_get_port_index());
    } else {
        kprintf("AHCI: no disponible\n");
    }

    kprintf("\n");
    syscall_init();          // registra tambien los SYS_FB_* / SYS_KEY_POLL / ...
    user_init();

    // --- raton + FAT32 + wallpaper ---------------------------------
    kprintf("Iniciando Raton...\n");
    if (mouse_init() == 0) kprintf("Raton: OK\n");
    else                   kprintf("Raton: fallo al inicializar\n");

    kprintf("Iniciando FAT32...\n");
    uint32_t lba = fat32_scan();
    if (lba && fat32_mount(lba)) {
        kprintf("FAT32: montado en LBA %u\n", lba);
        kprintf("Cargando fondo de pantalla (/FONDO.BMP)...\n");
        if (wallpaper_load("/FONDO.BMP"))
            kprintf("Fondo: cargado con exito\n");
        else
            kprintf("Fondo: no se pudo cargar (usando fondo por defecto)\n");
    } else {
        kprintf("FAT32: no disponible\n");
    }

    kprintf("\n");
    thread_init();
    win_init();               // subsistema de ventanas (kernel o userspace)
    kprintf("Threads listos\nVentanas listas\n");

    // --- IRQs y lanzar desktop en ring3 ----------------------------
    asm volatile("sti");

    if (gfx_backbuffer_active()) gfx_backbuffer_flip();

    kprintf("\nLanzando desktop (ring3)...\n");
    user_spawn("/DESKTOP.ELF");   // tu loader de ELF actual

    // Si el desktop muere, el kernel no debe caer en bucle con IRQs
    while (1) {
        asm volatile("hlt");
    }
}

