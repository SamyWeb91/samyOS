#include "screen.h"
#include "io.h"

#define ATA_DATA        0x1F0
#define ATA_SECCOUNT    0x1F2
#define ATA_LBA_LOW     0x1F3
#define ATA_LBA_MID     0x1F4
#define ATA_LBA_HIGH    0x1F5
#define ATA_DRIVE_HEAD  0x1F6
#define ATA_COMMAND     0x1F7
#define ATA_STATUS      0x1F7

#define ATA_BSY  0x80
#define ATA_DRDY 0x40
#define ATA_DF   0x20
#define ATA_DRQ  0x08
#define ATA_ERR  0x01

static int wait_bsy_clear() {
    for (int i = 0; i < 100000; i++) {
        if (!(inb(ATA_STATUS) & ATA_BSY)) return 0;
    }
    return -1;
}

static int wait_drq_set() {
    for (int i = 0; i < 100000; i++) {
        unsigned char s = inb(ATA_STATUS);
        if (s & ATA_DRQ) return 0;
        if (s & (ATA_ERR | ATA_DF)) return -1;
    }
    return -1;
}

static void test_drive(unsigned char sel, const char *name) {
    kprintf("\n--- %s (sel=0x%x) ---\n", name, sel);

    outb(ATA_DRIVE_HEAD, sel);
    io_wait(); io_wait(); io_wait(); io_wait();

    unsigned char st = inb(ATA_STATUS);
    kprintf("Status inicial: 0x%x ", st);
    if (st == 0x00) { kprintf("(no hay disco)\n"); return; }
    if (st == 0xFF) { kprintf("(no hay controlador)\n"); return; }
    kprintf("\n");

    if (wait_bsy_clear() != 0) { kprintf("BSY no baja\n"); return; }

    st = inb(ATA_STATUS);
    kprintf("Status tras BSY: 0x%x ", st);
    if (!(st & ATA_DRDY)) { kprintf("(DRDY=0)\n"); return; }
    kprintf("(DRDY=1)\n");

    outb(ATA_SECCOUNT, 1);
    outb(ATA_LBA_LOW,  0);
    outb(ATA_LBA_MID,  0);
    outb(ATA_LBA_HIGH, 0);
    outb(ATA_COMMAND,  0x20);

    if (wait_drq_set() != 0) {
        kprintf("DRQ no se activa. Status=0x%x\n", inb(ATA_STATUS));
        return;
    }

    unsigned char buf[512];
    unsigned short *p = (unsigned short*)buf;
    for (int i = 0; i < 256; i++) p[i] = inw(ATA_DATA);

    kprintf("Bytes 0-15: ");
    for (int i = 0; i < 16; i++) kprintf("%02x ", buf[i]);
    kprintf("\n");

    kprintf("Bytes 510-511: %02x %02x ", buf[510], buf[511]);
    if (buf[510] == 0x55 && buf[511] == 0xAA)
        kprintf("FIRMA OK\n");
    else
        kprintf("(sin firma)\n");
}

extern "C" void kernel_main() {
    screen_clear();
    kprintf("MiniOS Diagnostico ATA\n");
    kprintf("======================\n");

    test_drive(0xE0, "Master LBA");
    test_drive(0xF0, "Slave  LBA");
    test_drive(0xA0, "Master CHS");
    test_drive(0xB0, "Slave  CHS");

    kprintf("\n=== FIN ===\n");

    while (1) {}
}




