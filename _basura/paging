#include "paging.h"
#include "screen.h"

static unsigned int page_directory[1024] __attribute__((aligned(4096)));
static unsigned int page_table_0[1024]   __attribute__((aligned(4096)));

// Page Tables adicionales para mapear mas memoria
static unsigned int page_table_1[1024]   __attribute__((aligned(4096)));
static unsigned int page_table_2[1024]   __attribute__((aligned(4096)));
static unsigned int page_table_3[1024]   __attribute__((aligned(4096)));

extern "C" void paging_enable_asm(unsigned int pd_phys);

void paging_init() {
    // Limpiar el Page Directory
    for (int i = 0; i < 1024; i++) {
        page_directory[i] = 0;
    }

    // Limpiar las Page Tables
    for (int i = 0; i < 1024; i++) {
        page_table_0[i] = 0;
        page_table_1[i] = 0;
        page_table_2[i] = 0;
        page_table_3[i] = 0;
    }

    // Identity mapping de los primeros 4 MB (Page Table 0)
    for (int i = 0; i < 1024; i++) {
        unsigned int phys = i * 0x1000;
        page_table_0[i] = phys | PTE_PRESENT | PTE_RW;
    }
    page_directory[0] = ((unsigned int)page_table_0) | PTE_PRESENT | PTE_RW;

    // Mapear los siguientes 4 MB en 0x400000-0x7FFFFF (Page Table 1)
    // para tener mas espacio
    for (int i = 0; i < 1024; i++) {
        unsigned int phys = 0x400000 + i * 0x1000;
        page_table_1[i] = phys | PTE_PRESENT | PTE_RW;
    }
    page_directory[1] = ((unsigned int)page_table_1) | PTE_PRESENT | PTE_RW;
}

void paging_enable_now() {
    paging_enable_asm((unsigned int)page_directory);
}

void paging_map(unsigned int virt, unsigned int phys, unsigned int flags) {
    unsigned int pd_index = virt >> 22;
    unsigned int pt_index = (virt >> 12) & 0x3FF;

    // Si la Page Table para este indice no existe, la creamos
    if (!(page_directory[pd_index] & PTE_PRESENT)) {
        // Alojar una nueva Page Table de 4 KB en .bss (simplificado)
        // Como no tenemos un allocator dinamico de PT, usamos una estatica
        // y la limpiamos
        unsigned int *new_pt;
        if (pd_index == 2)      new_pt = page_table_2;
        else if (pd_index == 3) new_pt = page_table_3;
        else return;   // solo soportamos hasta pd_index 3

        for (int i = 0; i < 1024; i++) new_pt[i] = 0;
        page_directory[pd_index] = ((unsigned int)new_pt) | PTE_PRESENT | PTE_RW;
    }

    unsigned int *pt = (unsigned int*)(page_directory[pd_index] & 0xFFFFF000);
    pt[pt_index] = (phys & 0xFFFFF000) | (flags & 0xFFF) | PTE_PRESENT;

    // Invalidar TLB
    asm volatile("invlpg (%0)" : : "r"(virt) : "memory");
}

void paging_map_range(unsigned int virt, unsigned int phys, unsigned int size_kb, unsigned int flags) {
    for (unsigned int i = 0; i < size_kb; i++) {
        paging_map(virt + i * 0x1000, phys + i * 0x1000, flags);
    }
}

unsigned int paging_get_pd_addr()  { return (unsigned int)page_directory; }
unsigned int paging_get_pt0_addr() { return (unsigned int)page_table_0; }
